# Copy to .env and edit. Every value has a sensible default (see src/research_agent/config.py).
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:4b-instruct
# Fallback if qwen3 tool calling misbehaves:
# CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
NUM_CTX=8192
TEMPERATURE=0.2

# Agent budgets (small models loop; cap everything)
MAX_SUBQUESTIONS=3
RESEARCHER_MAX_MODEL_CALLS=4
MAX_REVISIONS=1
STRUCTURED_OUTPUT_RETRIES=2

# Tools
ENABLE_WEB=true
SEARCH_MAX_RESULTS=4
FETCH_TIMEOUT_S=10
FETCH_MAX_CHARS=3000
KB_TOP_K=4
KB_MIN_SCORE=0.45
KB_GRADE=true

# Storage
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHECKPOINT_DB=data/checkpoints.sqlite

LOG_LEVEL=INFO
LOG_JSON=true

# Optional LangSmith tracing (off by default, needs a free account + key)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
